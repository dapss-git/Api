{
  "openapi": "1.0.0",
  "info": {
    "title": "Daps",
    "author": "Daps",
    "version": "v1.0.0",
    "description": "Simple and easy to use API."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Downloader"
    },
    {
      "name": "Search"
    },
    {
      "name": "Info"
    },
    {
      "name": "Image"
    },
    {
      "name": "News"
    }
  ],
  "paths": {
    "/download/pixiv": {
      "get": {
        "summary": "Pixiv Download",
        "description": "Mengunduh file gambar asli Pixiv ke direktori lokal",
        "tags": ["Downloader"],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID karya Pixiv atau link artwork"
          },
          {
            "name": "all_pages",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["false", "true"], "default": "false" },
            "description": "Set 'true' untuk mengunduh semua halaman"
          },
          {
            "name": "out_dir",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "downloads" },
            "description": "Folder tujuan (default 'downloads')"
          }
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "creator": { "type": "string", "example": "Daps" },
                    "result": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "description": "Parameter id wajib diisi" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/search/pixiv": {
      "get": {
        "summary": "Pixiv Search",
        "description": "Mencari karya Pixiv berdasarkan kata kunci",
        "tags": ["Search"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Kata kunci pencarian"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 },
            "description": "Halaman pencarian (default 1)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Jumlah hasil maksimal"
          },
          {
            "name": "no_upload",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["false", "true"], "default": "false" },
            "description": "Set 'true' untuk mematikan upload thumbnail"
          }
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "creator": { "type": "string", "example": "Daps" },
                    "result": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "400": { "description": "Parameter q wajib diisi" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/info/pixiv": {
      "get": {
        "summary": "Pixiv Detail",
        "description": "Mengambil detail karya dan link gambar Pixiv berdasarkan ID atau link",
        "tags": ["Info"],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID karya Pixiv atau link artwork"
          },
          {
            "name": "no_upload",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["false", "true"], "default": "false" },
            "description": "Set 'true' untuk mematikan upload gambar"
          }
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "creator": { "type": "string", "example": "Daps" },
                    "result": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "description": "Parameter id wajib diisi" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/image/pixiv": {
      "get": {
        "summary": "Pixiv Random",
        "description": "Mengambil sejumlah karya secara acak dari Pixiv",
        "tags": ["Image"],
        "parameters": [
          {
            "name": "num",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 5 },
            "description": "Jumlah karya acak (default 5)"
          },
          {
            "name": "no_upload",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["false", "true"], "default": "false" },
            "description": "Set 'true' untuk mematikan upload otomatis"
          }
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "creator": { "type": "string", "example": "Daps" },
                    "result": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/download/spotify": {
      "get": {
        "summary": "Spotify / Spotify Play",
        "description": "Cari dan download musik Spotify berdasarkan judul lagu atau URL track Spotify",
        "tags": [
          "Downloader"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Judul lagu atau URL track Spotify",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "creator": {
                      "type": "string",
                      "example": "Daps"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "example": "Sesi Potret"
                        },
                        "artist": {
                          "type": "string",
                          "example": "eńau, Ari Lesmana"
                        },
                        "album": {
                          "type": "string",
                          "example": "Sesi Potret"
                        },
                        "duration": {
                          "type": "string",
                          "example": "4:03"
                        },
                        "image": {
                          "type": "string",
                          "format": "uri",
                          "example": "https://i.scdn.co/image/..."
                        },
                        "download_url": {
                          "type": "string",
                          "format": "uri",
                          "example": "https://rapid.spotidown.app/..."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parameter query atau url tidak disertakan"
          },
          "500": {
            "description": "Gagal memproses request atau lagu tidak ditemukan"
          }
        }
      }
    },
    "/download/spotifyplay": {
      "get": {
        "summary": "Spotify Play",
        "description": "Play dan download musik Spotify berdasarkan judul lagu atau query",
        "tags": [
          "Downloader"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Judul lagu atau URL track Spotify",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "creator": {
                      "type": "string",
                      "example": "Daps"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "example": "Sesi Potret"
                        },
                        "artist": {
                          "type": "string",
                          "example": "eńau, Ari Lesmana"
                        },
                        "album": {
                          "type": "string",
                          "example": "Sesi Potret"
                        },
                        "duration": {
                          "type": "string",
                          "example": "4:03"
                        },
                        "image": {
                          "type": "string",
                          "format": "uri",
                          "example": "https://i.scdn.co/image/..."
                        },
                        "download_url": {
                          "type": "string",
                          "format": "uri",
                          "example": "https://rapid.spotidown.app/..."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parameter query atau url tidak disertakan"
          },
          "500": {
            "description": "Gagal memproses request atau lagu tidak ditemukan"
          }
        }
      }
    },
    "/image/bluearchive": {
      "get": {
        "summary": "Blue Archive",
        "description": "Blue Archive Random Images",
        "tags": [
          "Image"
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "images": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Gagal memproses request"
          }
        }
      }
    },
    "/news/detik": {
      "get": {
        "summary": "Detik News",
        "description": "Scraping berita terpopuler dari Detik.com",
        "tags": [
          "News"
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "berita": {
                        "type": "string",
                        "example": "Judul berita terpopuler Detik"
                      },
                      "berita_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://news.detik.com/berita/..."
                      },
                      "berita_thumb": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true,
                        "example": "https://akcdn.detik.net.id/...jpg"
                      },
                      "berita_diupload": {
                        "type": "string",
                        "example": "Senin, 25 Nov 2024 10:30 WIB"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Gagal memproses request"
          }
        }
      }
    },
    "/news/kontan": {
      "get": {
        "summary": "Kontan News",
        "description": "Scraping berita terbaru dari Kontan.co.id",
        "tags": [
          "News"
        ],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "berita": {
                        "type": "string",
                        "example": "Rupiah menguat terhadap dolar AS pada perdagangan pagi ini"
                      },
                      "berita_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://www.kontan.co.id/news/rupiah-menguat"
                      },
                      "berita_thumb": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true,
                        "example": "https://img.kontan.co.id/thumb.jpg"
                      },
                      "berita_jenis": {
                        "type": "string",
                        "example": "Makro Ekonomi"
                      },
                      "berita_diupload": {
                        "type": "string",
                        "example": "2 jam lalu"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Gagal memproses request"
          }
        }
      }
    }
  }
}